---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="breadcrumb" class="container px-4 pt-24 pb-2">
  <ol class="flex flex-wrap items-center gap-2 text-sm">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          <a href={item.href} class:list={["hover:underline", i === items.length - 1 ? "text-foreground font-semibold" : "text-primary"]}>{item.name}</a>
          {i < items.length - 1 && <span class="text-muted-foreground">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
