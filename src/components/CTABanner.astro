---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<section class="relative py-16 md:py-20 overflow-hidden">
  <div class="absolute inset-0 diamond-plate opacity-30"></div>
  <div class="absolute inset-0 bg-background/80"></div>
  <div class="absolute top-0 left-0 right-0 h-1 bg-primary"></div>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary"></div>

  <div class="container px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-foreground tracking-wider">
        NEED MATERIAL <span class="text-primary">HAULED TODAY?</span>
      </h2>
      <p class="mt-4 text-muted-foreground text-lg">Our team is standing by to dispatch a truck to your job site. Fast, reliable, guaranteed.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-8 justify-center items-center">
        <div class="flex flex-col items-center">
          <span class="text-[10px] font-bold uppercase tracking-widest text-primary mb-1 animate-pulse">Call {site.phoneJoe.label}!</span>
          <a href={`tel:${site.phoneJoe.tel}`} class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-8 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
            <Icon name="phone" class="w-5 h-5 text-green-500" /> {site.phoneJoe.display}
          </a>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-[10px] font-bold uppercase tracking-widest text-primary mb-1 animate-pulse">Call {site.phoneLuke.label}!</span>
          <a href={`tel:${site.phoneLuke.tel}`} class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-8 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
            <Icon name="phone" class="w-5 h-5 text-green-500" /> {site.phoneLuke.display}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
