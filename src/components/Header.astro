---
import Icon from "./Icon.astro";
import { nav, site } from "../data/site";
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="container flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/assets/fs-logo.png" alt="F&S Expedited LLC" class="h-10 w-auto" width="40" height="40" />
      <span class="font-heading font-bold text-lg text-foreground leading-none">
        F&amp;S <span class="text-primary">EXPEDITED</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {
        nav.map((item) => {
          if (item.cta) {
            return (
              <a href={item.href} class="ml-2 inline-flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-colors">
                <Icon name="phone" class="w-4 h-4 text-green-500" /> {item.label}
              </a>
            );
          }
          if (item.dropdown) {
            return (
              <div class="relative group">
                <a href={item.href} class="inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-foreground hover:text-primary">
                  {item.label} <Icon name="chevron-down" class="w-4 h-4" />
                </a>
                <div class="absolute left-0 top-full hidden pt-2 group-hover:block">
                  <div class="w-72 rounded-xl border border-border bg-card p-3 shadow-elevated">
                    {item.dropdown.map((node) =>
                      node.divider ? (
                        <hr class="my-2 border-border" />
                      ) : (
                        <a
                          href={node.href}
                          class:list={[
                            "block rounded px-3 py-1.5 text-sm hover:bg-background",
                            node.featured ? "font-semibold text-primary" : "text-muted-foreground hover:text-foreground",
                          ]}
                        >
                          {node.label}
                        </a>
                      )
                    )}
                  </div>
                </div>
              </div>
            );
          }
          if (item.label === "Blog") {
            return (
              <a href={item.href} class="rounded-md px-3 py-2 text-[15px] font-semibold text-cyan-300 hover:text-cyan-200">{item.label}</a>
            );
          }
          return (
            <a href={item.href} class="rounded-md px-3 py-2 text-sm font-medium text-foreground hover:text-primary">{item.label}</a>
          );
        })
      }
    </nav>

    <button type="button" class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-foreground" id="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
      <Icon name="menu" class="w-6 h-6" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-background">
    <nav class="container flex flex-col py-4" aria-label="Mobile">
      {
        nav.map((item) => {
          if (item.cta) {
            return (
              <a href={item.href} class="mt-2 inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-4 py-3 rounded-lg text-sm font-semibold">
                <Icon name="phone" class="w-4 h-4 text-green-500" /> {item.label}
              </a>
            );
          }
          if (item.dropdown) {
            return (
              <div class="py-2 border-b border-border">
                <a href={item.href} class="block px-2 py-1 text-sm font-semibold text-foreground">{item.label}</a>
                <div class="pl-3">
                  {item.dropdown.map((node) =>
                    node.divider ? null : (
                      <a href={node.href} class="block px-2 py-1 text-sm text-muted-foreground hover:text-primary">{node.label}</a>
                    )
                  )}
                </div>
              </div>
            );
          }
          if (item.label === "Blog") {
            return <a href={item.href} class="px-2 py-2 text-[15px] font-semibold text-cyan-300 hover:text-cyan-200 border-b border-border">{item.label}</a>;
          }
          return <a href={item.href} class="px-2 py-2 text-sm font-medium text-foreground hover:text-primary border-b border-border">{item.label}</a>;
        })
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
