---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { posts } from "../../data/posts";
import { breadcrumbSchema } from "../../lib/schemas";

const crumbs = [
  { name: "Home", url: "https://www.fs-expeditedllc.com/" },
  { name: "Blog", url: "https://www.fs-expeditedllc.com/blog" },
];

const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title="F&S Expedited Blog — Hauling Tips, Guides & Company News | Shelby, NC"
  description="Practical hauling, material delivery, and site-service insights from F&S Expedited LLC. Serving Shelby, Charlotte, Gastonia, Asheville, and across Western NC."
  canonical="/blog"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="relative py-20 bg-gradient-to-br from-primary/10 via-background to-secondary/10">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-primary font-semibold tracking-widest text-sm uppercase font-sans">From The Road</span>
        <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-foreground">The F&amp;S Expedited Blog</h1>
        <p class="mt-6 text-xl text-muted-foreground">
          Hauling tips, material guides, and project know-how from the crew keeping Carolina job sites moving.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-background">
    <div class="container mx-auto px-4">
      {
        sorted.length === 0 ? (
          <p class="text-center text-muted-foreground">No posts yet — check back soon.</p>
        ) : (
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {sorted.map((post) => (
              <a href={`/blog/${post.slug}`} class="group bg-card border border-border rounded-2xl overflow-hidden hover-card-lift flex flex-col">
                <div class="relative h-48 overflow-hidden">
                  <img src={post.image ?? "/assets/hero-truck.jpg"} alt={post.title} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-card to-transparent" />
                  <span class="absolute top-4 left-4 text-xs font-semibold uppercase tracking-widest text-primary-foreground bg-primary/90 px-3 py-1 rounded-full">
                    {post.category}
                  </span>
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <span class="text-xs text-muted-foreground">{formatDate(post.date)}</span>
                  <h2 class="mt-2 text-xl font-heading font-bold text-foreground group-hover:text-primary">{post.title}</h2>
                  <p class="mt-2 text-sm text-muted-foreground flex-1">{post.excerpt}</p>
                  <span class="mt-4 inline-flex items-center gap-2 text-primary font-semibold text-sm">
                    Read More <Icon name="arrow-right" class="w-4 h-4" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <ContactCTA />
</Layout>
