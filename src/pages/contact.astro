---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { breadcrumbSchema, localBusinessSchema } from "../lib/schemas";

const crumbs = [
  { name: "Home", href: "https://www.fs-expeditedllc.com/" },
  { name: "Contact", href: "https://www.fs-expeditedllc.com/contact" },
];
const schema = { "@context": "https://schema.org", "@graph": [localBusinessSchema, breadcrumbSchema(crumbs)] };
---

<Layout
  title="Contact Us — Get a Free Hauling Quote"
  description="Call F&S Expedited LLC for a free hauling estimate. Dump truck services within 100 miles of Shelby, NC. Call (865) 364-9011 or (704) 751-8141."
  canonical="/contact"
  schemas={[schema]}
>
  <section class="relative py-16 overflow-hidden">
    <img src="/assets/gallery/fleet-sterling-trucks.jpg" alt="F&S Expedited fleet ready for hauling in Shelby, NC" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-white tracking-wider">GET A FREE QUOTE</h1>
      <p class="mt-4 text-lg text-gray-200 max-w-2xl mx-auto">Call Joe or Luke — we'll give you a transparent, no-obligation estimate for your next haul.</p>
    </div>
  </section>
  <Breadcrumbs items={crumbs} />
  <ContactCTA />
  <section class="py-8 bg-background">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <img src="/assets/gallery/papaw-truck-convoy.jpg" alt="F&S trucks lined up and ready to keep projects moving" class="w-full h-64 object-cover rounded-xl border border-border shadow-lg" loading="lazy" />
        <p class="text-center text-sm text-muted-foreground mt-3">Our trucks are staged and ready — call today and we'll dispatch fast.</p>
      </div>
    </div>
  </section>
</Layout>
