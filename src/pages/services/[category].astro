---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { serviceCategories, services } from "../../data/services";
import { breadcrumbSchema } from "../../lib/schemas";

export function getStaticPaths() {
  return serviceCategories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
// Option A duplicate-slug resolution: a service whose slug equals its category
// slug is the category's flagship service. Its content is merged into this page
// instead of living on a duplicate /<cat>/<cat>/ URL.
const flagshipService = services.find((s) => s.category === category.slug && s.slug === category.slug);
const categoryServices = services.filter((s) => s.category === category.slug && s.slug !== category.slug);
const otherCategories = serviceCategories.filter((c) => c.slug !== category.slug);

const crumbs = [
  { name: "Home", url: "https://www.fs-expeditedllc.com/" },
  { name: "Services", url: "https://www.fs-expeditedllc.com/services" },
  { name: category.title, url: `https://www.fs-expeditedllc.com/services/${category.slug}` },
];
---

<Layout
  title={`${category.title} | F&S Expedited LLC`}
  description={category.description}
  canonical={`/services/${category.slug}`}
  image={category.heroImage}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="relative py-24 overflow-hidden">
    <img src={category.heroImage} alt={`${category.title} in the Carolinas`} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/50 to-transparent"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-4xl mx-auto text-center bg-black/60 backdrop-blur-sm rounded-2xl p-8">
        <div class="mb-6 w-16 h-16 mx-auto rounded-xl bg-primary/90 flex items-center justify-center text-primary-foreground">
          <Icon name={category.icon} class="w-8 h-8" />
        </div>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white">{category.title}</h1>
        <p class="mt-6 text-xl text-gray-200">{category.description}</p>
        {category.intro && <p class="mt-4 text-lg text-gray-300/90">{category.intro}</p>}
      </div>
    </div>
  </section>

  <section class="section-padding bg-background">
    <div class="container mx-auto px-4">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          categoryServices.map((s) => (
            <a href={`/services/${category.slug}/${s.slug}`} class="group bg-card border border-border rounded-2xl p-8 hover-card-lift flex flex-col">
              <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-5">
                <Icon name={s.icon} class="w-7 h-7" />
              </div>
              <h2 class="text-3xl font-heading font-bold text-foreground group-hover:text-primary">{s.title}</h2>
              <p class="mt-3 text-lg text-muted-foreground flex-1">{s.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {s.features.slice(0, 3).map((f) => (
                  <span class="text-xs rounded-full bg-secondary px-3 py-1 text-secondary-foreground">{f}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    flagshipService && (
      <section class="section-padding bg-background">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-2xl font-heading font-bold text-foreground mb-4">{flagshipService.title}</h2>
            <p class="text-lg text-muted-foreground leading-relaxed">{flagshipService.longDescription}</p>
            <h3 class="mt-8 text-xl font-heading font-semibold text-foreground mb-3">What's Included</h3>
            <div class="flex flex-wrap gap-2">
              {flagshipService.features.map((f) => (
                <span class="inline-flex items-center gap-2 rounded-full bg-secondary px-4 py-2 text-sm text-secondary-foreground">
                  <Icon name="check" class="w-4 h-4 text-primary" /> {f}
                </span>
              ))}
            </div>
            <h3 class="mt-8 text-xl font-heading font-semibold text-foreground mb-3">Why Choose F&S</h3>
            <ul class="space-y-2">
              {flagshipService.benefits.map((b) => (
                <li class="flex items-start gap-3 text-sm text-muted-foreground">
                  <Icon name="check-circle" class="w-5 h-5 text-primary shrink-0 mt-0.5" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="section-padding relative overflow-hidden">
    <img src="/assets/gallery/gravel-jobsite-excavator.jpg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-br from-background/80 via-background/70 to-background/85"></div>
    <div class="container mx-auto px-4 relative">
      <h2 class="text-2xl font-heading font-bold text-center text-foreground mb-8">Other Service Categories</h2>
      <div class="grid gap-4 sm:grid-cols-3 max-w-4xl mx-auto">
        {
          otherCategories.map((c) => (
            <a href={`/services/${c.slug}`} class="bg-card border border-border rounded-xl p-5 text-center hover-card-lift">
              <Icon name={c.icon} class="w-7 h-7 text-primary mx-auto mb-2" />
              <span class="font-heading font-semibold text-foreground">{c.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
