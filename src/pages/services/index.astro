---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { serviceCategories, services } from "../../data/services";
import { breadcrumbSchema } from "../../lib/schemas";
import { site } from "../../data/site";

const crumbs = [
  { name: "Home", url: "https://www.fs-expeditedllc.com/" },
  { name: "Services", url: "https://www.fs-expeditedllc.com/services" },
];

const servicesByCat = serviceCategories.map((cat) => ({
  ...cat,
  items: services.filter((s) => s.category === cat.slug),
}));
---

<Layout
  title="Dump Truck Hauling & Material Delivery Services | F&S Expedited LLC"
  description="Explore F&S Expedited's dump truck hauling, gravel & material delivery, site services, and emergency expedited hauling across the Carolinas."
  canonical="/services"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="relative py-20 bg-gradient-to-br from-primary/10 via-background to-secondary/10">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-primary font-semibold tracking-widest text-sm uppercase font-sans">What We Do</span>
        <h1 class="mt-4 text-4xl md:text-5xl font-heading font-bold text-foreground">Our Services</h1>
        <p class="mt-6 text-xl text-muted-foreground">
          From bulk dump truck hauling to precision site prep, F&amp;S Expedited keeps Carolina job sites moving. Explore our core service categories below.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-background">
    <div class="container mx-auto px-4">
      <div class="grid gap-8 md:grid-cols-2">
        {
          servicesByCat.map((cat) => (
            <div class="bg-card border border-border rounded-2xl overflow-hidden hover-card-lift">
              <div class="relative h-48 overflow-hidden">
                <img src={cat.heroImage} alt={cat.title} class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-card to-transparent" />
                <div class="absolute top-4 left-4 w-12 h-12 rounded-xl bg-primary/90 flex items-center justify-center text-primary-foreground">
                  <Icon name={cat.icon} class="w-6 h-6" />
                </div>
              </div>
              <div class="p-6">
                <h2 class="text-2xl font-heading font-bold text-foreground">{cat.title}</h2>
                <p class="mt-2 text-muted-foreground">{cat.description}</p>
                <p class="mt-3 text-sm text-muted-foreground/80">{cat.intro}</p>
                <ul class="mt-4 grid sm:grid-cols-2 gap-2">
                  {cat.items.map((s) => (
                    <li>
                      <a href={`/services/${cat.slug}/${s.slug}`} class="flex items-center gap-2 text-sm text-foreground hover:text-primary">
                        <Icon name="arrow-right" class="w-4 h-4 text-primary" /> {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={`/services/${cat.slug}`} class="mt-6 inline-flex items-center gap-2 text-primary font-semibold hover:underline">
                  View {cat.title} <Icon name="arrow-right" class="w-4 h-4" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
