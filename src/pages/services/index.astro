---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { serviceCategories, services } from "../../data/services";
import { breadcrumbSchema } from "../../lib/schemas";
import { site } from "../../data/site";

const crumbs = [
  { name: "Home", url: "https://www.fs-expeditedllc.com/" },
  { name: "Services", url: "https://www.fs-expeditedllc.com/services" },
];

const servicesByCat = serviceCategories.map((cat) => ({
  ...cat,
  items: services.filter((s) => s.category === cat.slug),
}));

const categoryDetails = [
  {
    slug: "dump-trucks-hauling-services",
    tagline: "Your material. Our muscle.",
    image: "/assets/hero-truck.jpg",
    items: [
      "Bulk dirt, gravel, sand, and debris transport",
      "Site-to-site hauling across the Carolinas",
      "Residential and commercial dump truck service",
      "Flexible scheduling — same-day dispatch available",
    ],
  },
  {
    slug: "material-delivery",
    tagline: "Right material. Right time. Right place.",
    image: "/assets/material-delivery.png",
    items: [
      "Gravel, crushed stone, road base, and decorative stone",
      "Fill dirt, topsoil, sand, and fill material",
      "Aggregate, limestone, and recycled concrete",
      "Bulk delivery — spread or dumped to your specs",
    ],
  },
  {
    slug: "site-services",
    tagline: "Heavy-duty support for heavy-duty work.",
    image: "/assets/site-services.png",
    items: [
      "Land clearing, grading, and site preparation",
      "Construction debris removal and demolition cleanup",
      "Retaining walls, underground utilities, and land grading",
      "Aggregate transport for large-scale projects",
    ],
  },
  {
    slug: "emergency-expedited",
    tagline: "We work when others don't.",
    image: "/assets/emergency-services.png",
    items: [
      "Same-day and next-day emergency hauling",
      "Priority dispatch over standard orders",
      "24/7 availability for urgent projects",
      "No surprise fees — transparent pricing",
    ],
  },
];
---

<Layout
  title="Dump Truck Services & Material Delivery | F&S Expedited LLC"
  description="Explore F&S Expedited's dump truck hauling, gravel & material delivery, site services, and emergency expedited hauling across the Carolinas."
  canonical="/services"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="relative py-28 overflow-hidden bg-black">
    <div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/50 to-black/80"></div>
    <div class="container mx-auto px-4 relative">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-primary font-semibold tracking-widest text-sm uppercase font-sans">What We Do</span>
        <h1 class="mt-4 text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-white tracking-tight">
          YOUR MATERIAL.<br />OUR MUSCLE.
        </h1>
        <p class="mt-6 text-xl text-gray-200 max-w-2xl mx-auto">
          Hauling, delivery, and site support across North &amp; South Carolina — fast, dependable, and ready when you are.
        </p>
      </div>
    </div>
  </section>

  {
    categoryDetails.map((cat, i) => {
      const catData = serviceCategories.find((c) => c.slug === cat.slug);
      const catServices = services.filter((s) => s.category === cat.slug);
      const isEven = i % 2 === 0;
      return (
        <section class:list={["py-16 md:py-24", isEven ? "bg-background" : "bg-gradient-card"]}>
          <div class="container mx-auto px-4">
            <div class:list={["grid gap-12 lg:grid-cols-2 items-center", !isEven && "lg:[direction:rtl]"]}>
              <div class:list={[!isEven && "lg:[direction:ltr]"]}>
                <img
                  src={cat.image}
                  alt={catData?.title}
                  class="w-full h-64 md:h-80 lg:h-96 object-cover rounded-2xl border border-border shadow-lg"
                  loading="lazy"
                />
              </div>
              <div class:list={["lg:[direction:ltr]"]}>
                <span class="text-primary font-semibold tracking-widest text-sm uppercase font-sans">{catData?.title}</span>
                <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-foreground tracking-tight">
                  {cat.tagline}
                </h2>
                <p class="mt-4 text-lg text-muted-foreground leading-relaxed">{catData?.intro}</p>
                <ul class="mt-6 space-y-3">
                  {cat.items.map((item) => (
                    <li class="flex items-start gap-3">
                      <Icon name="check-circle" class="w-5 h-5 text-green-500 shrink-0 mt-0.5" />
                      <span class="text-muted-foreground">{item}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                  <a
                    href={`/services/${cat.slug}`}
                    class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors"
                  >
                    View {catData?.title} <Icon name="arrow-right" class="w-4 h-4" />
                  </a>
                  <a
                    href={`tel:${site.phoneJoe.tel}`}
                    class="inline-flex items-center justify-center gap-2 bg-secondary text-secondary-foreground px-6 py-3 rounded-lg font-semibold hover:bg-secondary/90 transition-colors"
                  >
                    <Icon name="phone" class="w-4 h-4 text-green-500" /> Get a Quote
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <ContactCTA />
</Layout>
