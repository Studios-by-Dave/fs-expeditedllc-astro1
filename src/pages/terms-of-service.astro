---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbSchema } from "../lib/schemas";

const crumbs = [
  { name: "Home", href: "https://www.fs-expeditedllc.com/" },
  { name: "Terms of Service", href: "https://www.fs-expeditedllc.com/terms-of-service" },
];

const sections = [
  {
    title: "Acceptance of Terms",
    body: "By accessing or using the services of F&S Expedited LLC (\"Company,\" \"we,\" \"us,\" or \"our\"), you agree to be bound by these Terms of Service. If you do not agree, please do not use our services.",
  },
  {
    title: "Services Provided",
    body: "F&S Expedited LLC provides dump truck hauling, material delivery, debris removal, site preparation, and related transportation services within a 100-mile radius of Shelby, NC. Service availability, scheduling, and pricing are subject to change without notice.",
  },
  {
    title: "Quotes and Pricing",
    body: "All quotes are estimates and valid for 30 days unless otherwise stated. Final pricing may vary based on actual load volume, distance, material type, site conditions, and additional requirements. We reserve the right to adjust pricing after a site assessment.",
  },
  {
    title: "Scheduling and Dispatch",
    body: "We make every effort to meet requested scheduling. Same-day and expedited dispatch is available but not guaranteed. Delays caused by weather, road conditions, equipment failure, or circumstances beyond our control do not constitute grounds for liability.",
  },
  {
    title: "Payment Terms",
    items: [
      "Payment is due upon completion of services unless otherwise agreed in writing.",
      "We accept cash, check, and electronic transfers.",
      "A 1.5% monthly late fee may apply to overdue balances.",
      "Returned checks are subject to a $50 fee.",
    ],
  },
  {
    title: "Customer Responsibilities",
    items: [
      "Ensure job site access is clear and safe for heavy equipment.",
      "Provide accurate information about load requirements and site conditions.",
      "Obtain any necessary permits for material delivery or hauling.",
      "Notify us of any hazardous materials or conditions at the job site.",
    ],
  },
  {
    title: "Liability Limitations",
    body: "F&S Expedited LLC is licensed and insured. However, we are not liable for damage to unpaved surfaces, underground utilities not marked by the customer, or conditions caused by force majeure events. Our liability is limited to the total amount paid for the specific service in question.",
  },
  {
    title: "Cancellation Policy",
    body: "Cancellations made 24 hours or more before scheduled dispatch are accepted without penalty. Cancellations within 24 hours of dispatch may be subject to a trip charge. No-shows without prior notice will be billed in full.",
  },
  {
    title: "Intellectual Property",
    body: "All content on this website, including text, images, logos, and graphics, is the property of F&S Expedited LLC and protected by copyright law. You may not reproduce or distribute any content without written permission.",
  },
  {
    title: "Governing Law",
    body: "These Terms of Service are governed by the laws of the State of North Carolina. Any disputes shall be resolved in the courts of Cleveland County, NC.",
  },
  {
    title: "Changes to Terms",
    body: "We reserve the right to update these Terms of Service at any time. Changes take effect immediately upon posting to this page. Your continued use of our services constitutes acceptance of the updated terms.",
  },
  {
    title: "Contact Us",
    body: "Questions about these Terms of Service? Contact us at (865) 364-9011, (704) 751-8141, or email Aldrich2577@gmail.com.",
  },
];
---

<Layout
  title="Terms of Service — F&S Expedited LLC"
  description="Terms and conditions governing the use of F&S Expedited LLC hauling, delivery, and site services. Read our full terms of service."
  canonical="/terms-of-service"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <section class="py-12 bg-background">
    <div class="container px-4">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-foreground tracking-wider mb-6">Terms of Service</h1>
        <p class="text-lg text-muted-foreground mb-10 font-sans">
          These Terms of Service govern your use of F&S Expedited LLC's hauling, material delivery, and site services.
          Please read them carefully.
        </p>

        <div class="space-y-10">
          {
            sections.map((section) => (
              <div>
                <h2 class="text-2xl font-heading font-bold text-foreground tracking-wide mb-3">{section.title}</h2>
                {section.body && <p class="text-muted-foreground font-sans leading-relaxed">{section.body}</p>}
                {section.items && (
                  <ul class="list-disc pl-6 space-y-2 text-muted-foreground font-sans">
                    {section.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </div>
            ))
          }
        </div>

        <div class="mt-12 pt-8 border-t border-border text-sm text-muted-foreground">
          © {new Date().getFullYear()} F&S Expedited LLC. All rights reserved.
        </div>
      </div>
    </div>
  </section>
</Layout>
